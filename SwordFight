local RunService = game:GetService("RunService")
local autoUseFriends = {}
local heartbeatFriend
local originalSpeed = nil
local autoUseToolEnabled = false
_G.autoUseToolEnabled = false

local blockedTools = {
    ["RocketLauncher"] = true,
    ["MagicCarpet"] = true,
    ["terbanfly"] = true,
}

local speedTools = {
    ["SuperSpeedCoil"] = 16,
    ["UltraSpeedCoil"] = 32
}

local function getHumanoid()
    local character = player.Character
    if character then
        return character:FindFirstChildOfClass("Humanoid")
    end
    return nil
end

local function disconnectAll()
    for _, conn in ipairs(autoUseFriends) do
        if conn.Disconnect then conn:Disconnect() end
    end
    autoUseFriends = {}
    if heartbeatFriend then
        heartbeatFriend:Disconnect()
        heartbeatFriend = nil
    end
end

local function toggleAutoUseTool()
    autoUseToolEnabled = not autoUseToolEnabled
    _G.autoUseToolEnabled = autoUseToolEnabled
    buttons[3].Text = "Auto Use Tool" .. (autoUseToolEnabled and "    O" or "")

    disconnectAll()

    local humanoid = getHumanoid()
    if autoUseToolEnabled then
        if humanoid then
            originalSpeed = humanoid.WalkSpeed
        else
            originalSpeed = 16
        end
    end

    local character = player.Character
    if not character then return end

    local currentTool

    local function onToolEquipped(tool)
        if tool and not blockedTools[tool.Name] then
            currentTool = tool
        end
    end

    local function connectToolListeners(char)
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") then
                onToolEquipped(tool)
            end
        end
        table.insert(autoUseFriends, char.ChildAdded:Connect(function(child)
            if autoUseToolEnabled and child:IsA("Tool") then
                onToolEquipped(child)
            end
        end))
        table.insert(autoUseFriends, char.ChildRemoved:Connect(function(child)
            if child == currentTool then
                currentTool = nil
            end
        end))
    end

    connectToolListeners(character)
    table.insert(autoUseFriends, player.CharacterAdded:Connect(connectToolListeners))

    heartbeatFriend = RunService.Heartbeat:Connect(function()
        local humanoid = getHumanoid()
        if humanoid then
            if autoUseToolEnabled and currentTool and speedTools[currentTool.Name] then
                humanoid.WalkSpeed = originalSpeed + speedTools[currentTool.Name]
            elseif autoUseToolEnabled then
                humanoid.WalkSpeed = originalSpeed
            else
                humanoid.WalkSpeed = originalSpeed or 16
            end
        end

        if autoUseToolEnabled and currentTool and currentTool.Parent == player.Character then
            pcall(function()
                currentTool:Activate()
            end)
        end
    end)

    if not autoUseToolEnabled and humanoid then
        humanoid.WalkSpeed = originalSpeed or 16
        if heartbeatFriend then
            heartbeatFriend:Disconnect()
            heartbeatFriend = nil
        end
    end
end

