task.defer(function()
    local t = 0
    local speedAnim = 1
    local direction = 1

    local color1 = Color3.fromRGB(16, 16, 48)
    local color2 = Color3.fromRGB(40, 0, 64)
    local lightText = Color3.fromRGB(255, 255, 255)
    local darkText = Color3.fromRGB(0, 255, 255)
    local buttonBg = Color3.fromRGB(0, 0, 0)

    local allButtons = {}
    for _, btn in ipairs(buttons) do
        table.insert(allButtons, btn)
    end
    table.insert(allButtons, minimizeButton)

    local allPanels = {}
    for _, obj in ipairs(hubContainer:GetChildren()) do
        if obj:IsA("Frame") and obj ~= hubContainer then
            table.insert(allPanels, obj)
        end
    end

    while true do
        t = t + direction * speedAnim * 0.01
        if t >= 1 then
            t = 1
            direction = -1
        elseif t <= 0 then
            t = 0
            direction = 1
        end

        local fadeColor = color1:Lerp(color2, t)
        hubContainer.BackgroundColor3 = fadeColor

        local brightness = (fadeColor.R + fadeColor.G + fadeColor.B)/3
        local textColor = (brightness > 0.2) and lightText or darkText

        title.TextColor3 = textColor

        for _, btn in ipairs(allButtons) do
            btn.BackgroundColor3 = buttonBg
            btn.TextColor3 = textColor
        end

        for _, panel in ipairs(allPanels) do
            panel.BackgroundColor3 = fadeColor
            for _, item in ipairs(panel:GetDescendants()) do
                if item:IsA("TextLabel") or item:IsA("TextButton") or item:IsA("TextBox") then
                    item.TextColor3 = textColor
                    if item:IsA("TextButton") or item:IsA("TextBox") then
                        item.BackgroundColor3 = buttonBg
                    end
                end
            end
        end

        task.wait(0.01)
    end
end)
