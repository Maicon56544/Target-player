local function onSwordsTeleporterClicked()
    _G.swordsTeleporterEnabled = not _G.swordsTeleporterEnabled
    buttons[5].Text = "Last Death Position" .. (_G.swordsTeleporterEnabled and "    O" or "")

    local lastDeathPosition
    local tycoonNames = {"Black Base", "Red Base", "Green Base", "Pink Base", "Orange Base", "Yellow Base", "Purple Base", "Blue Base"}

    local function bringTwoSwordsToPlayer()
        local character = player.Character or player.CharacterAdded:Wait()
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local tycoonsFolder = workspace:WaitForChild("Tycoons"):WaitForChild("Tycoons")
        local foundGivers = {}

        for _, name in ipairs(tycoonNames) do
            local tycoon = tycoonsFolder:FindFirstChild(name)
            if tycoon then
                local firebrand = tycoon:FindFirstChild("PurchasedObjects"):FindFirstChild("Firebrand")
                if firebrand and firebrand:FindFirstChild("Giver") then
                    table.insert(foundGivers, firebrand.Giver)
                    if #foundGivers == 2 then
                        break
                    end
                end
            end
        end

        for _, giver in ipairs(foundGivers) do
            local originalCFrame = giver.CFrame
            local originalTransparency = giver.Transparency
            giver.CanCollide = false
            giver.Transparency = 1
            giver.CFrame = hrp.CFrame
            task.wait(0.01)
            giver.CFrame = originalCFrame
            giver.Transparency = 0
        end
    end

    local function teleportOnRespawn()
        if not _G.swordsTeleporterEnabled then return end
        local character = player.Character or player.CharacterAdded:Wait()
        local hrp = character:WaitForChild("HumanoidRootPart")
        if lastDeathPosition and lastDeathPosition.Y > -50 then
            task.wait(0.01)
            hrp.CFrame = CFrame.new(lastDeathPosition)
        end
        bringTwoSwordsToPlayer()
        lastDeathPosition = nil
    end

    local function setupDeathListener(character)
        local humanoid = character:WaitForChild("Humanoid")
        local hrp = character:WaitForChild("HumanoidRootPart")
        humanoid.Died:Connect(function()
            lastDeathPosition = hrp.Position
            player.CharacterAdded:Wait()
            teleportOnRespawn()
        end)
    end

    if not _G.swordsTeleporterInitialized then
        _G.swordsTeleporterInitialized = true
        if player.Character then setupDeathListener(player.Character) end
        player.CharacterAdded:Connect(setupDeathListener)
    end

    if _G.swordsTeleporterEnabled then
        bringTwoSwordsToPlayer()
    end
end

local function onAntiVoidClicked()
    if not (_G.antiVoidEnabled or _G.antiVoid2Enabled) then
        _G.antiVoidEnabled = true
        buttons[6].Text = "Anti Void 1   O"
    else
        _G.antiVoidEnabled = false
        _G.antiVoid2Enabled = false
        buttons[6].Text = "Anti Void"
    end

    if _G.antiVoidInitialized then return end
    _G.antiVoidInitialized = true

    local safePositions = {}
    local voidThresholdY = -50

    local function hasGroundBelow(position)
        local rayOrigin = position
        local rayDirection = Vector3.new(0, -5, 0)
        local raycastParams = RaycastParams.new()
        raycastParams.FilterDescendantsInstances = {player.Character}
        raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
        local result = workspace:Raycast(rayOrigin, rayDirection, raycastParams)
        return result and result.Instance and result.Instance.CanCollide
    end

    local function saveSafeCFrame(cframe)
        table.insert(safePositions, cframe)
        if #safePositions > maxSafePositions then
            table.remove(safePositions, 1)
        end
    end

    local function getValidSafeCFrame()
        for i = #safePositions, 1, -1 do
            local cframe = safePositions[i]
            if hasGroundBelow(cframe.Position) then
                return cframe
            end
        end
        return nil
    end

    RunService.Heartbeat:Connect(function()
        if not (_G.antiVoidEnabled or _G.antiVoid2Enabled) then return end

        local character = player.Character
        if not character then return end
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        if hasGroundBelow(hrp.Position) then
            saveSafeCFrame(hrp.CFrame)
        end

        if _G.antiVoid_isTeleporting then return end

        if _G.antiVoidEnabled then
            local currentY = hrp.Position.Y
            local velocityY = hrp.Velocity.Y

            if _G.antiVoid_lastY then
                local fallDistance = _G.antiVoid_lastY - currentY
                if velocityY < fallSpeedThreshold or fallDistance > fallHeightThreshold then
                    local validCFrame = getValidSafeCFrame()
                    if validCFrame then
                        _G.antiVoid_isTeleporting = true
                        task.wait(0.05)
                        hrp.CFrame = validCFrame
                        task.wait(0.4)
                        _G.antiVoid_isTeleporting = false
                    end
                end
            end
            _G.antiVoid_lastY = currentY
        elseif _G.antiVoid2Enabled then
            local currentY = hrp.Position.Y
            if currentY < voidThresholdY then
                local validCFrame = getValidSafeCFrame()
                if validCFrame then
                    _G.antiVoid_isTeleporting = true
                    task.wait(0.05)
                    hrp.CFrame = validCFrame
                    task.wait(0.4)
                    _G.antiVoid_isTeleporting = false
                end
            end
        end
    end)
end

