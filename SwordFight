local function onRocketLauncherClicked()
    _G.spamRocketsEnabled = not _G.spamRocketsEnabled
    task.spawn(function()
        local char = player.Character
        local tool = char and char:FindFirstChild("RocketLauncher")
        local rootPart = char and char:FindFirstChild("HumanoidRootPart")

        if not (char and tool and rootPart and tool:FindFirstChild("BattleRocketEvent")) then
            _G.spamRocketsEnabled = false
            return
        end

        local battleRocketEvent = tool.BattleRocketEvent

        while _G.spamRocketsEnabled do
            task.wait(rocketDelay)
            char = player.Character
            tool = char and char:FindFirstChild("RocketLauncher")
            rootPart = char and char:FindFirstChild("HumanoidRootPart")
            battleRocketEvent = tool and tool:FindFirstChild("BattleRocketEvent")

            if not (char and tool and rootPart and battleRocketEvent) then
                _G.spamRocketsEnabled = false
                break
            end

            local center = rootPart.Position + rootPart.CFrame.LookVector * 30
            local bombPositions = table.create(numBombs)
            local angleStep = 360 / numBombs
            for i = 1, numBombs do
                local angle = math.rad(angleStep * i)
                bombPositions[i] = Vector3.new(
                    center.X + radius * math.cos(angle),
                    center.Y,
                    center.Z + radius * math.sin(angle)
                )
            end
            for i = 1, numBombs do
                battleRocketEvent:FireServer(bombPositions[i])
            end
            battleRocketEvent:FireServer(center)
        end
    end)
end

