-- Função para criar painel de configuração
local function createConfigPanel(offsetY, labelsAndDefaults, assignFuncs)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0, 25, 0, 25)
    button.Position = UDim2.new(0, 165, 0, offsetY + 7)
    button.Text = "⚙️"
    button.TextColor3 = Color3.fromRGB(255, 215, 0)
    button.Font = Enum.Font.GothamBold
    button.TextSize = 14
    button.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    button.BackgroundTransparency = 1
    button.Parent = hubContainer
    createUICorner(button, 6)

    local panel = Instance.new("Frame")
    panel.Size = UDim2.new(0, 180, 0, 50 + (#labelsAndDefaults * 30))
    panel.Position = UDim2.new(0, -180, 0, offsetY)
    panel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    panel.BackgroundTransparency = 0.4
    panel.Visible = false
    panel.Parent = hubContainer
    createUICorner(panel, 10)

    for i, entry in ipairs(labelsAndDefaults) do
        local isCheckbox = entry.label:find("Anti%-Void")
        local isSimpleButton = entry.isButton == true

        local label = Instance.new("TextLabel")
        label.Text = entry.label
        label.Size = UDim2.new(0, 120, 0, 20)
        label.Position = UDim2.new(0, 5, 0, 10 + ((i - 1) * 30))
        label.TextColor3 = Color3.fromRGB(255, 215, 0)
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.Gotham
        label.TextSize = 13
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = panel

        if isSimpleButton then
            local button = Instance.new("TextButton")
            button.Text = "O"
            button.Size = UDim2.new(0, 40, 0, 20)
            button.Position = UDim2.new(0, 135, 0, 10 + ((i - 1) * 30))
            button.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            button.BackgroundTransparency = 0.4
            button.TextColor3 = Color3.fromRGB(255, 215, 0)
            button.Font = Enum.Font.Gotham
            button.TextSize = 13
            button.Parent = panel
            createUICorner(button, 5)

            button.MouseButton1Click:Connect(function()
                assignFuncs[i]()
            end)
        elseif isCheckbox then
            local check = Instance.new("TextButton")
            check.Size = UDim2.new(0, 40, 0, 20)
            check.Position = UDim2.new(0, 135, 0, 10 + ((i - 1) * 30))
            check.Text = entry.default == "On" and "O" or ""
            check.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            check.BackgroundTransparency = 0.4
            check.TextColor3 = Color3.fromRGB(255, 215, 0)
            check.Font = Enum.Font.Gotham
            check.TextSize = 13
            check.Parent = panel
            createUICorner(check, 5)

            check.MouseButton1Click:Connect(function()
                local newState = check.Text == "" and 1 or 0
                assignFuncs[i](newState)
                check.Text = newState == 1 and "O" or ""
            end)
        else
            local box = Instance.new("TextBox")
            box.Text = tostring(entry.default)
            box.Size = UDim2.new(0, 40, 0, 20)
            box.Position = UDim2.new(0, 135, 0, 10 + ((i - 1) * 30))
            box.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            box.BackgroundTransparency = 0.4
            box.TextColor3 = Color3.fromRGB(255, 215, 0)
            box.Font = Enum.Font.Gotham
            box.TextSize = 13
            box.ClearTextOnFocus = false
            box.Parent = panel
            createUICorner(box, 5)

            box.FocusLost:Connect(function()
                local val = tonumber(box.Text)
                if val then
                    assignFuncs[i](val)
                else
                    box.Text = "Inv"
                end
            end)
        end
    end

    button.MouseButton1Click:Connect(function()
        panel.Visible = not panel.Visible
    end)
end

